# Asterism daemon — the dispatcher, run in FOREGROUND for systemd.
# USER unit (no sudo): install to ~/.config/systemd/user/, then
#   loginctl enable-linger $USER
#   systemctl --user daemon-reload
#   systemctl --user enable --now asterism-daemon
# Scope lives in ~/Asterism/.asterism/daemon.env (create it):
#   ASTERISM_SCOPE=Test.%
# Adjust WorkingDirectory/PATH if the checkout is not ~/Asterism.
#
# DESIGN (owner-ruled 2026-08-24, one deliberate deviation — see the
# boarding doc): the Lean gateway stays a DAEMON-MANAGED child, not
# its own unit. The daemon kills/relaunches the gateway itself on
# pool mismatch (a separate systemd unit would fight that), and
# KillMode=process preserves the Windows semantics: stopping or
# restarting the daemon leaves the warm gateway running.
# MemoryMax covers the WHOLE cgroup (daemon + gateway + lean workers
# + spawns) — a LIFELINE, not a resource manager (owner ruling
# 2026-08-26): its only job is that a runaway fleet OOM-kills inside
# this slice while sshd and systemd stay reachable. Resource
# management is the RAM ledger's alone (`core/ram_ledger`: the budget
# models the footprint, the measured available-RAM floor vetoes).
# MemoryHigh is deliberately ABSENT — it was a second, silent governor
# that fought the ledger: with no swap, the only reclaimable pages in
# the cgroup are the mmap'd olean set every worker shares, so crossing
# memory.high put the kernel in an evict/refault loop against the
# fleet (load 60 on 8 cores, memory PSI full 88%, twice on
# 2026-08-26). Keep MemoryMax comfortably ABOVE the ledger budget +
# its cache reserve; per-box override: `systemctl --user edit
# asterism-daemon`.

[Unit]
Description=Asterism daemon (dispatcher; manages the Lean gateway)
After=network-online.target asterism-zen-shim.service
Wants=asterism-zen-shim.service
# StartLimit* live in [Unit] — in [Service] this systemd IGNORES them
# with a journal warning (observed 2026-08-24), leaving Restart
# unbraked. Unlogged provider / missing Lean cache exits early — 3
# tries per 10 minutes, then stay down instead of burning quota.
# (Code-drift handoff exits rc=75 → Restart=on-failure relaunches on
# current code; deploys are rare enough to never trip this brake.)
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/Asterism
EnvironmentFile=-%h/Asterism/.asterism/daemon.env
Environment=PYTHONIOENCODING=utf-8
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PATH=%h/.elan/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env python3.12 -m Tooling.core.cli run --scope ${ASTERISM_SCOPE}
# Graceful stop: write the stop file (drain in-flight), then systemd
# waits TimeoutStopSec for the main process before SIGTERM/SIGKILL.
ExecStop=/usr/bin/env python3.12 -m Tooling.core.cli daemon stop
TimeoutStopSec=1800
# Only the MAIN process dies on stop/restart — the gateway child and
# any draining spawn trees survive in the cgroup (Windows-parity).
KillMode=process
Restart=on-failure
RestartSec=10
MemoryAccounting=true
MemoryMax=95%

[Install]
WantedBy=default.target
