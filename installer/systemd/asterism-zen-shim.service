# Asterism zen shim — LLM channel translator on 127.0.0.1:8898.
# USER unit (no sudo): install to ~/.config/systemd/user/, then
#   loginctl enable-linger $USER        # keep running after logout
#   systemctl --user daemon-reload
#   systemctl --user enable --now asterism-zen-shim
# Adjust WorkingDirectory/paths if the checkout is not ~/Asterism.
# Keys come from <workspace>/.env (the shim reads it itself) — never
# bake them into this file.

[Unit]
Description=Asterism zen shim (port 8898)
After=network-online.target
# StartLimit* live in [Unit] — in [Service] this systemd IGNORES them
# (journal warning, 2026-08-24). A missing key exits at startup
# (SystemExit in _key_for) — do not burn CPU in a restart loop; 5
# tries per 5 minutes, then stop.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/Asterism
Environment=PYTHONIOENCODING=utf-8
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
ExecStart=/usr/bin/env python3.12 -m Tooling.llm.zen_shim 8898
Restart=on-failure
RestartSec=5
MemoryAccounting=true
MemoryMax=2G

[Install]
WantedBy=default.target
