import Mathlib
import Problems.residue_thm.Defs

namespace Problems.residue_thm

-- entry_kind: Builder
theorem subst_linear_2t_minus_1
    {Q : ℂ → ℂ} {β' : ℝ → ℂ} :
    (∫ t in ((1/2) : ℝ)..1, Q (β' (2*t - 1)) * (2 * deriv β' (2*t - 1))) =
      (∫ t in (0 : ℝ)..1, Q (β' t) * deriv β' t) := by sorry

end Problems.residue_thm
